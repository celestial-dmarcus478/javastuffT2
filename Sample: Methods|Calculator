import java.util.Scanner;
public class W4A1Celestial {
	//name the methods for operations
	static void /*name for the method*/CelestialAddition(/*declare stuff here*/int a, int b) {
		System.out.println(a+b);}
	static void CelestialDivision(int g, int h) {
		//Used different values here cuz you cant use brackets in switch case
		System.out.println(g/h);}
	static void CelestialMultiplication(int e, int f) {
		System.out.println(e*f);}
	static void CelestialSubtraction(int c, int d) {
		System.out.println(c-d);}
	public static void main(String[]args) {
		 Scanner input = new Scanner(System.in);
		 System.out.println("Select arithmetic");
	System.out.println("a) Addition");
	System.out.println("b) Subtraction");
	System.out.println("c) Multiplication");
	System.out.println("d) Division");
	String choice = input.nextLine();
	//the methods are used here
	switch (choice) {
	case "a":
		System.out.println("Value for num1: ");
		int a = input.nextInt();
		System.out.println("Value for num2: ");
		int b = input.nextInt();
		// the two values will be solved with the assigned method:(arithmeticoperator)
		CelestialAddition(a,b);
		break;
	case "b":
		System.out.println("Value for num1: ");
		int c = input.nextInt();
		System.out.println("Value for num2: ");
		int d = input.nextInt();
		CelestialSubtraction(c,d);
		break;
	case "c":
		System.out.println("Value for num1: ");
		int e = input.nextInt();
		System.out.println("Value for num2: ");
		int f = input.nextInt();
		CelestialMultiplication( e, f);
		break;
	case "d":
		System.out.println("Value for num1: ");
		int g = input.nextInt();
		System.out.println("Value for num2: ");
		int h = input.nextInt();
		CelestialDivision( g, h);
		break;
	}
}
}
